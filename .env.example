DB_PASSWORD=replace-with-a-long-random-password
APP_HOSTS=localhost,127.0.0.1
SITE_ADDRESS=:80
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
HTTPS_PORT=8443

# Cloudflare Turnstile
# Enable after configuring a widget for the deployed domain.
# Never commit real secret keys.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=lilimistudio.com
