spring.datasource.url=jdbc:postgresql://localhost:15432/lilimi
spring.datasource.username=lilimi
spring.datasource.password=replace-with-your-local-password

# Local email testing with Mailpit
spring.mail.host=127.0.0.1
spring.mail.port=1025
spring.mail.properties[mail.smtp.auth]=false
spring.mail.properties[mail.smtp.starttls.enable]=false
spring.mail.properties[mail.smtp.connectiontimeout]=5000
spring.mail.properties[mail.smtp.timeout]=5000
spring.mail.properties[mail.smtp.writetimeout]=5000

lilimi.mail.from=contact@lilimistudio.com
lilimi.public-base-url=http://localhost:4200

# Process order confirmation emails locally through Mailpit
lilimi.mail.order-confirmation.enabled=true
