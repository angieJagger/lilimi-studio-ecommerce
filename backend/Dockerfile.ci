FROM eclipse-temurin:21-jre-jammy

RUN groupadd --system app && useradd --system --gid app app \
    && apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade apt libapt-pkg6.0 \
    && apt-get install -y --no-install-recommends curl libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN mkdir -p /app/var/media && chown app:app /app/var/media

ENV MEDIA_STORAGE_DIRECTORY=/app/var/media

COPY --chown=app:app ci-artifacts/backend.jar app.jar

USER app
EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
